# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/code_reviewer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_reviewer

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Обмеження та безпека
MAX_CODE_CHARS=20000
# Адреси клієнта через кому
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Відновлення пароля. Адреса клієнта, яка потрапляє в посилання з листа
APP_URL=http://localhost:5173
# Пошта для листів (Gmail). Якщо не заповнити, посилання для скидання пароля
# з'явиться в логах: docker compose logs api
# Для Gmail потрібен "пароль застосунку": Акаунт Google -> Безпека -> Двоетапна перевірка -> Паролі застосунків
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# App
APP_ENV=development
DEBUG=true
